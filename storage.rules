rules_version = '2';

/**
 * REGLAS DE SEGURIDAD PARA GOOGLE CLOUD STORAGE
 * Proyecto: streamepro-6f5a3 (StreamePro)
 * 
 * Protege la subida de comprobantes de pago, imágenes de catálogo y recursos de marketing
 * impidiendo la subida de archivos ejecutables, scripts o documentos excesivos.
 */

service firebase.storage {
  match /b/{bucket}/o {
    
    // Comprobantes de pago (Imágenes JPG, PNG, WEBP o PDF hasta 5MB)
    match /receipts/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*|application/pdf');
    }
    
    // Portadas, Flyers y Diseños de Redes (Imágenes hasta 10MB)
    match /flyers/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }
    
    // Regla general para otros assets públicos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }
  }
}
