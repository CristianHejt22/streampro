{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/og-image.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "spro.li"
        }
      ],
      "destination": "https://streamepro.me/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.spro.li"
        }
      ],
      "destination": "https://streamepro.me/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/p/:id",
      "destination": "/api/product-preview?prod=:id"
    },
    {
      "source": "/p/:id/:ref",
      "destination": "/api/product-preview?prod=:id&ref=:ref"
    },
    {
      "source": "/producto/:id",
      "destination": "/api/product-preview?prod=:id"
    },
    {
      "source": "/producto/:id/:ref",
      "destination": "/api/product-preview?prod=:id&ref=:ref"
    },
    {
      "source": "/j/:id",
      "destination": "/api/product-preview?game=:id"
    },
    {
      "source": "/j/:id/:ref",
      "destination": "/api/product-preview?game=:id&ref=:ref"
    },
    {
      "source": "/juego/:id",
      "destination": "/api/product-preview?game=:id"
    },
    {
      "source": "/juego/:id/:ref",
      "destination": "/api/product-preview?game=:id&ref=:ref"
    },
    {
      "source": "/combo/:id",
      "destination": "/api/product-preview?pkg=:id"
    },
    {
      "source": "/combo/:id/:ref",
      "destination": "/api/product-preview?pkg=:id&ref=:ref"
    },
    {
      "source": "/servicio/:id",
      "destination": "/api/product-preview?plat=:id"
    },
    {
      "source": "/servicio/:id/:ref",
      "destination": "/api/product-preview?plat=:id&ref=:ref"
    },
    {
      "source": "/seleccion",
      "destination": "/api/product-preview?multi=1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|WhatsApp|facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|LinkedInBot|Applebot|Pinterest|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/product-preview"
    },
    {
      "source": "/juegos",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|WhatsApp|facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|LinkedInBot|Applebot|Pinterest|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/product-preview?sec=gaming"
    },
    {
      "source": "/tienda",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|WhatsApp|facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|LinkedInBot|Applebot|Pinterest|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/product-preview?sec=physical"
    },
    {
      "source": "/combos",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|WhatsApp|facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|LinkedInBot|Applebot|Pinterest|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/product-preview?sec=packages"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
